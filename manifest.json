{
  "manifest_version": 2,
  "name": "PageQR",
  "version": "1.0",
  "description": "Generate QR codes for the current page URL",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["contextMenus", "activeTab", "downloads"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["qrcode.js", "content.js"]
    }
  ]
}